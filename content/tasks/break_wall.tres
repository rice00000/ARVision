[gd_resource type="Resource" script_class="Task" format=3]

[ext_resource type="Script" path="res://world/task.gd" id="1_task"]
[ext_resource type="Script" path="res://trials/session_plan.gd" id="2_plan"]
[ext_resource type="Script" path="res://trials/block.gd" id="3_block"]
[ext_resource type="Resource" path="res://trials/motion/motion_demo.tres" id="4_motion"]
[ext_resource type="Resource" path="res://content/tasks/tidy_shelf.tres" id="5_tidy_shelf"]

[sub_resource type="Resource" id="wall_1"]
script = ExtResource("3_block")
trial = ExtResource("4_motion")
rounds = 3
difficulty = 0.0
intro = "Magic dots! Sweep your hand the way they flow, then hold still. Get it right and the spell wall cracks!"
ray = false
pause_between = 3.0

[sub_resource type="Resource" id="level_1"]
script = ExtResource("2_plan")
title = "Break the wall, level 1"
greeting = ""
farewell = ""
blocks = Array[ExtResource("3_block")]([SubResource("wall_1")])

[sub_resource type="Resource" id="wall_2"]
script = ExtResource("3_block")
trial = ExtResource("4_motion")
rounds = 3
difficulty = 0.4
intro = "Magic dots! Sweep your hand the way they flow, then hold still. Get it right and the spell wall cracks!"
ray = false
pause_between = 3.0

[sub_resource type="Resource" id="level_2"]
script = ExtResource("2_plan")
title = "Break the wall, level 2"
greeting = ""
farewell = ""
blocks = Array[ExtResource("3_block")]([SubResource("wall_2")])

[resource]
script = ExtResource("1_task")
title = "Break the spell wall"
levels = Array[ExtResource("2_plan")]([SubResource("level_1"), SubResource("level_2")])
requires = Array[ExtResource("1_task")]([ExtResource("5_tidy_shelf")])

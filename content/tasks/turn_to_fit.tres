[gd_resource type="Resource" script_class="Task" format=3]

[ext_resource type="Script" path="res://world/task.gd" id="1_task"]
[ext_resource type="Script" path="res://world/task_level.gd" id="2_level"]

[sub_resource type="Resource" id="go"]
script = ExtResource("2_level")
id = &"go"
project = &"turn_to_fit"

[gd_resource type="Resource" script_class="Task" format=3]

[ext_resource type="Script" path="res://world/task.gd" id="1_task"]
[ext_resource type="Script" path="res://trials/session_plan.gd" id="2_plan"]
[ext_resource type="Script" path="res://trials/block.gd" id="3_block"]
[ext_resource type="Resource" path="res://trials/find/find.tres" id="4_find"]

[sub_resource type="Resource" id="find_1"]
script = ExtResource("3_block")
trial = ExtResource("4_find")
rounds = 3
difficulty = 0.1
intro = "Find the ingredient I name. Reach out and grab it. Raise your hand if you need help."
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="level_1"]
script = ExtResource("2_plan")
title = "Find the toys, level 1"
greeting = ""
farewell = ""
blocks = Array[ExtResource("3_block")]([SubResource("find_1")])

[sub_resource type="Resource" id="find_2"]
script = ExtResource("3_block")
trial = ExtResource("4_find")
rounds = 3
difficulty = 0.5
intro = "A bigger potion needs more ingredients. Find the one I name and grab it."
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="level_2"]
script = ExtResource("2_plan")
title = "Find the toys, level 2"
greeting = ""
farewell = ""
blocks = Array[ExtResource("3_block")]([SubResource("find_2")])

[sub_resource type="Resource" id="find_3"]
script = ExtResource("3_block")
trial = ExtResource("4_find")
rounds = 3
difficulty = 0.6
pins = Dictionary[StringName, float]({&"same_colour": 1.0, &"spacing": 1.4})
intro = "These ingredients all share one colour. Look at the shapes!"
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="level_3"]
script = ExtResource("2_plan")
title = "Find the toys, level 3"
greeting = ""
farewell = ""
blocks = Array[ExtResource("3_block")]([SubResource("find_3")])

[sub_resource type="Resource" id="find_4"]
script = ExtResource("3_block")
trial = ExtResource("4_find")
rounds = 3
difficulty = 0.3
pins = Dictionary[StringName, float]({&"same_shape": 1.0, &"colour_gap": 0.08})
intro = "Magic stones that look alike! One has a different colour. Find it and grab it!"
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="level_4"]
script = ExtResource("2_plan")
title = "Find the toys, level 4"
greeting = ""
farewell = ""
blocks = Array[ExtResource("3_block")]([SubResource("find_4")])

[sub_resource type="Resource" id="find_5"]
script = ExtResource("3_block")
trial = ExtResource("4_find")
rounds = 3
difficulty = 0.45
pins = Dictionary[StringName, float]({&"same_shape": 1.0, &"colour_gap": 0.04})
intro = "A tricky spell: one stone's colour is only a little different. Look closely!"
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="level_5"]
script = ExtResource("2_plan")
title = "Find the toys, level 5"
greeting = ""
farewell = ""
blocks = Array[ExtResource("3_block")]([SubResource("find_5")])

[resource]
script = ExtResource("1_task")
title = "Potion ingredients"
levels = Array[ExtResource("2_plan")]([SubResource("level_1"), SubResource("level_2"), SubResource("level_3"), SubResource("level_4"), SubResource("level_5")])
colour = 1

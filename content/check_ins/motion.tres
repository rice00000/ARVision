[gd_resource type="Resource" script_class="SessionPlan" format=3]

[ext_resource type="Script" path="res://trials/session_plan.gd" id="1_plan"]
[ext_resource type="Script" path="res://trials/block.gd" id="2_block"]
[ext_resource type="Resource" path="res://trials/motion/motion_demo.tres" id="3_motion"]

[sub_resource type="Resource" id="dots_easy"]
script = ExtResource("2_block")
trial = ExtResource("3_motion")
rounds = 2
probe = true
difficulty = 0.2
intro = "Magic dots! Sweep your hand the way they flow."
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="dots_middle"]
script = ExtResource("2_block")
trial = ExtResource("3_motion")
rounds = 2
probe = true
difficulty = 0.5
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="dots_hard"]
script = ExtResource("2_block")
trial = ExtResource("3_motion")
rounds = 2
probe = true
difficulty = 0.8
ray = false
pause_between = 1.0

[resource]
script = ExtResource("1_plan")
title = "Motion check-in"
greeting = "Check-in time! Let's see what your eyes can do today. No help this time. Just try your best."
farewell = "Thank you! That helps us see how your eyes are growing."
blocks = Array[ExtResource("2_block")]([SubResource("dots_easy"), SubResource("dots_middle"), SubResource("dots_hard")])

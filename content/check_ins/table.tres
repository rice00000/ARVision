[sub_resource type="Resource" id="colour_easy"]
script = ExtResource("2_block")
trial = ExtResource("4_colour")
rounds = 2
probe = true
difficulty = 0.3
intro = "Now find the block with the different colour."
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="colour_hard"]
script = ExtResource("2_block")
trial = ExtResource("4_colour")
rounds = 2
probe = true
difficulty = 0.6
ray = false
pause_between = 1.0

[resource]
script = ExtResource("1_plan")
title = "Table check-in"
greeting = "Check-in time! Let's see what your eyes can do today. No help this time. Just try your best."
farewell = "Thank you! That helps us see how your eyes are growing."
blocks = Array[ExtResource("2_block")]([SubResource("shapes_3"), SubResource("shapes_4"), SubResource("shapes_5"), SubResource("colour_easy"), SubResource("colour_hard")])

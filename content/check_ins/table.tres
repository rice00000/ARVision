[gd_resource type="Resource" script_class="SessionPlan" format=3]

[ext_resource type="Script" path="res://trials/session_plan.gd" id="1_plan"]
[ext_resource type="Script" path="res://trials/block.gd" id="2_block"]
[ext_resource type="Resource" path="res://trials/tidy/tidy.tres" id="3_tidy"]
[ext_resource type="Resource" path="res://trials/tidy/odd_color_adaptive.tres" id="4_colour"]

[sub_resource type="Resource" id="shapes_3"]
script = ExtResource("2_block")
trial = ExtResource("3_tidy")
rounds = 1
probe = true
difficulty = 0.0
pins = Dictionary[StringName, float]({
&"novel": 1.0,
&"match": 0.0
})
intro = "New shapes! Put each one on its shadow."
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="shapes_4"]
script = ExtResource("2_block")
trial = ExtResource("3_tidy")
rounds = 1
probe = true
difficulty = 0.34
pins = Dictionary[StringName, float]({
&"novel": 1.0,
&"match": 0.0
})
ray = false
pause_between = 1.0

[sub_resource type="Resource" id="shapes_5"]
script = ExtResource("2_block")
trial = ExtResource("3_tidy")
rounds = 1
probe = true
difficulty = 0.67
pins = Dictionary[StringName, float]({
&"novel": 1.0,
&"match": 0.0
})
ray = false

[gd_resource type="Resource" script_class="TrialDef" format=3]

[ext_resource type="Script" path="res://trials/trial_def.gd" id="1_def"]
[ext_resource type="Script" path="res://trials/trial_axis.gd" id="2_axis"]
[ext_resource type="PackedScene" path="res://trials/tidy/tidy.tscn" id="3_scene"]

[sub_resource type="Resource" id="match"]
script = ExtResource("2_axis")
name = &"match"
easy = 4.0

[sub_resource type="Resource" id="log2_colour_gap"]
script = ExtResource("2_axis")
name = &"log2_colour_gap"
easy = -2.25
hard = -8.0
driven = true

[resource]
script = ExtResource("1_def")
title = "Odd Color Adaptive"
scene = ExtResource("3_scene")
skill = &"colour_discrimination"
axes = Array[ExtResource("2_axis")]([SubResource("match"), SubResource("log2_colour_gap")])
notes = "One choice among three blocks. Only the hue gap follows the staircase."
step = 0.15
hint_after = 10.0
hint_fade = 0.0

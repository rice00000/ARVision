[resource]
script = ExtResource("1_def")
title = "Catch the butterflies"
scene = ExtResource("3_scene")
skill = &"butterfly_catch"
axes = Array[ExtResource("2_axis")]([SubResource("speed"), SubResource("butterflies"), SubResource("rings"), SubResource("radius"), SubResource("catch_radius"), SubResource("tolerance")])
notes = "Speed is the driven axis. Each butterfly is judged on its own: the hoop must meet it head-on, so this trains reading one moving thing's direction and acting on it (vision for action), not global motion; its own skill. A chasing swing is a wrong try. The round is won when every butterfly is in the net."
hint_after = 25.0
hint_fade = 0.0
max_hint = 1
time_limit = 120.0
